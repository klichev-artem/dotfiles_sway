mpd_host = "127.0.0.1"
mpd_port = "6600"
mpd_music_dir = "~/Music"

ncmpcpp_directory = "~/.config/ncmpcpp"

# Не запускаем никакие внешние программы при смене трека.
execute_on_song_change = ""
execute_on_player_state_change = ""

# Физическое удаление файлов из ncmpcpp запрещено.
allow_for_physical_item_deletion = "no"

# Не нужен mouse tracking.
mouse_support = "no"

# Удобство
autocenter_mode = "yes"
centered_cursor = "yes"
incremental_seeking = "yes"

playlist_display_mode = "columns"
browser_display_mode = "columns"
search_engine_display_mode = "columns"

song_columns_list_format = "(6f)[default]{NE} (28)[default]{a} (45)[default]{t|f} (20)[default]{b} (7f)[default]{l}"

song_status_format = "{%a - }{%t}|{%f}"

progressbar_look = "━━━"

header_visibility = "yes"
statusbar_visibility = "yes"
titles_visibility = "yes"

display_volume_level = "yes"
display_bitrate = "yes"
display_remaining_time = "no"

visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "Visualizer feed"
visualizer_in_stereo = "yes"

visualizer_type = "spectrum"
visualizer_fps = "60"
visualizer_autoscale = "yes"
visualizer_look = "●▮"
