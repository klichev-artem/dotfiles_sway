# ============================================================
# MAKO — RAW UNIX / WHITE ACCENT
# black • grey • square • terminal-first
# ============================================================

# Placement
anchor=top-right
layer=top
margin=12

# Geometry
width=360
height=110
padding=12
border-size=1
border-radius=0

# Typography
font=Iosevka Term 11
markup=1
format=<b>%s</b>\n%b

# Behavior
sort=-time
icons=1
max-icon-size=42
actions=1
history=1
max-visible=5
default-timeout=5000
ignore-timeout=0

# ------------------------------------------------------------
# PALETTE
#
# bg          #050505
# panel       #0A0A0A
# border      #303030
# muted       #5A5A5A
# soft        #8A8A8A
# foreground  #BDBDBD
# accent      #FFFFFF
# ------------------------------------------------------------

# Base notification
background-color=#080808F2
text-color=#BDBDBDFF
border-color=#303030FF

# White accent progress
progress-color=over #FFFFFF66


# ============================================================
# URGENCY
# ============================================================

[urgency=low]
background-color=#050505E6
text-color=#8A8A8AFF
border-color=#303030FF
default-timeout=3500

[urgency=normal]
background-color=#080808F2
text-color=#BDBDBDFF
border-color=#FFFFFFFF
default-timeout=5000

[urgency=critical]
background-color=#FFFFFFFF
text-color=#050505FF
border-color=#FFFFFFFF
default-timeout=0
